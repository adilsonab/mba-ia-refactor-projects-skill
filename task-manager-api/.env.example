# Copie para .env e ajuste. Nenhum valor real deve ser versionado.
SECRET_KEY=
DATABASE_URL=sqlite:///tasks.db
FLASK_DEBUG=0
HOST=0.0.0.0
PORT=5000
# Lista separada por vírgula (ex.: https://app.exemplo.com) ou * para qualquer origem
CORS_ORIGINS=*
LOG_LEVEL=INFO
# Notificações por e-mail (desligadas se SMTP_HOST/SMTP_USER vazios)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=
