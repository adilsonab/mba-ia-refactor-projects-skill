# Copie para .env e ajuste. Nenhum valor real deve ser versionado.

# Obrigatório em produção. Sem ele, uma chave aleatória é gerada a cada boot (tokens expiram ao reiniciar).
SECRET_KEY=troque-por-um-valor-aleatorio-longo
# Validade do token de login, em segundos
TOKEN_MAX_AGE=3600

DATABASE_URL=sqlite:///tasks.db

# Defaults seguros: debug desligado e bind local. Para expor na rede use HOST=0.0.0.0.
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000
# Vazio = CORS fechado (nenhuma origem externa). Lista separada por vírgula, ou * explicitamente.
CORS_ORIGINS=

LOG_LEVEL=INFO

# SMTP do NotificationService (sem credenciais, o envio fica desabilitado)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
