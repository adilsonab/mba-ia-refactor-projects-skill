# Copie para .env e ajuste. Nenhum valor real deve ser versionado.
SECRET_KEY=
# Validade (segundos) do token assinado emitido em POST /login (padrão: 8 horas)
TOKEN_MAX_AGE=28800
DATABASE_URL=sqlite:///tasks.db
FLASK_DEBUG=0
# Padrão 127.0.0.1 (só local). Use 0.0.0.0 para expor a API na rede
HOST=127.0.0.1
PORT=5000
# Origens liberadas, separadas por vírgula (ex.: https://app.exemplo.com). Vazio = CORS fechado
CORS_ORIGINS=
LOG_LEVEL=INFO
# Notificações por e-mail (desligadas se SMTP_HOST/SMTP_USER vazios)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=
