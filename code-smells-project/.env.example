# Copy to your environment (the app reads os.environ; no .env loader is required).
SECRET_KEY=
FLASK_DEBUG=0
# Default 127.0.0.1 (local only). Use 0.0.0.0 to expose the API on the network.
HOST=127.0.0.1
PORT=5000
APP_ENV=producao
DATABASE_PATH=loja.db
# Comma-separated allowed origins (e.g. https://loja.exemplo.com). Empty = CORS closed (no foreign origin).
CORS_ORIGINS=
# Validity (seconds) of the signed access token issued by POST /login (default: 8 hours)
TOKEN_MAX_AGE=28800
LOG_LEVEL=INFO
