# Copy to your environment (the app reads os.environ; no .env loader is required).
SECRET_KEY=
FLASK_DEBUG=0
HOST=0.0.0.0
PORT=5000
APP_ENV=producao
DATABASE_PATH=loja.db
# Comma-separated origins; "*" keeps the API open to any origin
CORS_ORIGINS=*
# Validity (seconds) of the signed access token issued by POST /login (default: 8 hours)
TOKEN_MAX_AGE=28800
LOG_LEVEL=INFO
