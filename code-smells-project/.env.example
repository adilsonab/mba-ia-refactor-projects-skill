# Copie para .env (ou exporte no ambiente). Nenhum valor abaixo é um segredo real.

# Chave de assinatura dos tokens. Se ausente, uma chave aleatória é gerada a cada boot (tokens expiram ao reiniciar).
SECRET_KEY=troque-por-um-valor-aleatorio-longo
# Validade do token de login, em segundos.
TOKEN_EXPIRES_SECONDS=3600

# Debug desligado por padrão. Use DEBUG=true apenas em desenvolvimento local.
DEBUG=false
# Bind local por padrão. Para expor na rede: HOST=0.0.0.0
HOST=127.0.0.1
PORT=5000

# Caminho do banco SQLite.
DB_PATH=loja.db

# CORS fechado por padrão (vazio = nenhuma origem externa). Lista separada por vírgula, ou * explicitamente.
CORS_ORIGINS=

LOG_LEVEL=INFO
