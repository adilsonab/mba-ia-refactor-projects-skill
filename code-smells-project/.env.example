# Copy to your environment (the app reads os.environ; no .env loader is required).
SECRET_KEY=
FLASK_DEBUG=0
HOST=0.0.0.0
PORT=5000
APP_ENV=producao
DATABASE_PATH=loja.db
# Comma-separated origins; "*" keeps the API open to any origin
CORS_ORIGINS=*
# Required to enable POST /admin/reset-db (header X-Admin-Token). Leave empty to disable it.
ADMIN_TOKEN=
LOG_LEVEL=INFO
