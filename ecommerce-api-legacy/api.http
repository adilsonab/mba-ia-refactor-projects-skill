@baseUrl = http://localhost:3000
# Preencha com o token retornado pelo login do admin (suba com ADMIN_PASSWORD definido)
@adminToken = cole-o-token-aqui

### Login (admin)
POST {{baseUrl}}/api/login
Content-Type: application/json

{
  "eml": "admin@fullcycle.com.br",
  "pwd": "a-senha-definida-em-ADMIN_PASSWORD"
}

### Checkout - sucesso
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "Guilherme",
  "eml": "gui@fullcycle.com.br",
  "pwd": "senhaforte",
  "c_id": 2,
  "card": "4111222233334444"
}

### Checkout - pagamento recusado
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "João",
  "eml": "joao@teste.com",
  "pwd": "123",
  "c_id": 1,
  "card": "5111222233334444"
}

### Relatório financeiro administrativo (admin)
GET {{baseUrl}}/api/admin/financial-report
Authorization: Bearer {{adminToken}}

### Deletar usuário (admin)
DELETE {{baseUrl}}/api/users/1
Authorization: Bearer {{adminToken}}
