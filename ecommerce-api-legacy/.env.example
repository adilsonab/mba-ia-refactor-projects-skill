# Porta HTTP (padrão: 3000)
PORT=3000
# Interface de rede (padrão: 127.0.0.1, só local). Use 0.0.0.0 para expor a API na rede
HOST=127.0.0.1
# Caminho do banco SQLite (padrão: :memory:, recriado com seed a cada boot)
DATABASE_PATH=:memory:
# Chave do gateway de pagamento (nunca versionar o valor real)
PAYMENT_GATEWAY_KEY=
# Credencial das rotas administrativas (Authorization: Bearer <ADMIN_TOKEN>). Vazio = rotas admin desabilitadas (401)
ADMIN_TOKEN=
