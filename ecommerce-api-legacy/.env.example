# Copie para o seu ambiente (ex.: export VAR=...). Nenhum valor real aqui.

# Rede
PORT=3000
# 127.0.0.1 por padrão; use 0.0.0.0 para expor na rede (explícito)
HOST=127.0.0.1
# Vazio = CORS fechado. Lista separada por vírgula libera só essas origens; "*" libera todas.
CORS_ORIGINS=

# Autenticação
# Sem SECRET_KEY, uma chave aleatória é gerada a cada boot (tokens invalidam ao reiniciar).
SECRET_KEY=troque-por-um-valor-aleatorio-longo
TOKEN_TTL_SECONDS=3600
ADMIN_EMAIL=admin@fullcycle.com.br
# Sem ADMIN_PASSWORD, o admin recebe uma senha aleatória não divulgada (login admin indisponível).
ADMIN_PASSWORD=

# Gateway de pagamento (simulado)
PAYMENT_GATEWAY_KEY=

# debug | info | warn | error
LOG_LEVEL=info
